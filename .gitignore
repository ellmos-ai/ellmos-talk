.mypy_cache/
.coverage
htmlcov/

# Local secrets & environment
.env
.env.*
.env.local

# Local databases & runtime data
*.db
*.sqlite
*.sqlite3
data/

# Certificates, keys & credentials
*.pem
*.key
*.p12
*.pfx
*.crt
.npmrc
.pypirc
credentials.json
secrets.json

# IDE & OS artifacts
.idea/
.vscode/
*.sublime-*
